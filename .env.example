# ---- Required ----
DATABASE_URL=postgres://school:change-me@localhost:5432/school
REDIS_URL=redis://localhost:6379
AUTH_SECRET=change-me-to-a-long-random-string
SITE_URL=https://www.your-school.edu.ph
ADMIN_EMAIL=admin@your-school.edu.ph
ADMIN_PASSWORD=ChangeMe!2026

# ---- Which school? ----
# "bnhs" = Bolo Norte National High School content. "template" = generic content built from the SCHOOL_* values below.
SCHOOL_PROFILE=template
SCHOOL_NAME=Your School Name
SCHOOL_SHORT_NAME=YSN
SCHOOL_CITY=Your Town
SCHOOL_PROVINCE=Your Province
SCHOOL_REGION=Your Region
SCHOOL_COUNTRY_CODE=PH
SCHOOL_TAGLINE=Learning for life
SCHOOL_ID=
SCHOOL_ADDRESS=
SCHOOL_EMAIL=
SCHOOL_PHONE=
SCHOOL_FACEBOOK=
SCHOOL_ESTABLISHED=
SCHOOL_LOCALE=en_PH
SCHOOL_POSTAL_CODE=
SCHOOL_STREET=
SCHOOL_LATITUDE=
SCHOOL_LONGITUDE=
SCHOOL_LEVELS=Junior High School and Senior High School

# ---- File storage: local disk by default ----
UPLOAD_DIR=./uploads
# Set S3_BUCKET to store uploads in S3 (AWS, Cloudflare R2, MinIO, Wasabi, Spaces…)
# S3_BUCKET=
# S3_REGION=ap-southeast-1
# S3_ENDPOINT=              # only for non-AWS providers
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=            # optional CDN / public bucket URL; otherwise files are served through /uploads/*
# S3_PREFIX=uploads/

# ---- Database backups ----
BACKUP_DIR=./backups
BACKUP_KEEP=14
# BACKUP_EVERY_HOURS=24     # automatic backups while the server runs
# BACKUP_TO_S3=false        # backups are copied to S3 (under backups/) when S3_BUCKET is set, unless false
